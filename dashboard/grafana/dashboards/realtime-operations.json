    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Current patients",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "hospital-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "rawSql": "SELECT current_patients FROM hospital.realtime_hospital_state ORDER BY event_time DESC LIMIT 1",
          "editorType": "sql",
          "queryType": "table"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
