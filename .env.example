# Synthetic-data local development only. Replace before exposing the service.
MINIO_ACCESS_KEY=hospital_lake_local
MINIO_SECRET_KEY=hospital_lake_local_password
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Local image built from pinned source; upstream MinIO pulls are unavailable.
MINIO_IMAGE=hospital-lake/minio:RELEASE.2025-04-22T22-12-26Z

MINIO_REGION=us-east-1
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_REST_PORT=8181

# Shared Spark settings (TV3). Endpoints above use Compose service names;
# host-side jobs must override them with reachable host addresses.
SPARK_MASTER=local[2]
ICEBERG_WAREHOUSE=s3://warehouse/

# Week 4 local Kafka (`make kafka-up`). Host clients (producer) use the published
# listener; Compose Spark uses Kafka's internal network listener kafka:29092.
KAFKA_PORT=9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STREAM_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPICS=hospital.events
KAFKA_STARTING_OFFSETS=latest
STREAM_CHECKPOINT_LOCATION=./checkpoints/stream-bronze
STREAM_CHECKPOINT_LOCATION_DOCKER=/tmp/checkpoints/stream-bronze
# Bounded micro-batches; throughput/memory impact still needs a live benchmark.
STREAM_MAX_OFFSETS=20000
STREAM_TRIGGER=10 seconds

# Optional direct Compose bronze-ingest source mount. The Make target derives
# this from INPUT_DIR; inputs are mounted read-only and must already exist.
# BRONZE_INPUT_DIR=./data/generated

# TV4 Week 3 Gold: deterministic cutoff (generator end_date) and bed capacity for
# all five canonical departments. `make gold-docker` reads them from .env;
# host-side `make gold` needs them exported.
GOLD_AS_OF=2026-09-01T00:00:00Z
GOLD_BED_CAPACITIES=ICU=20,EMERGENCY=40,CARDIOLOGY=50,INTERNAL_MEDICINE=60,SURGERY=50

# Host-side smoke client and published Docker port.
TRINO_HOST=localhost
TRINO_PORT=8080
# Optional host-reachable HTTP endpoint for smoke/benchmark probes.
# Otherwise the benchmark uses http://localhost:${TRINO_PORT}.
# TRINO_URL=http://localhost:8080

# Local Grafana login; replace the password outside a local demo.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=hospital_lake_local_grafana
CLINICAL_METRICS_STATE_DIR=./checkpoints/clinical-metrics
CLINICAL_SHUFFLE_PARTITIONS=2
CLICKHOUSE_ENDPOINT=http://localhost:8123
CLICKHOUSE_GRAFANA_PASSWORD=hospital_local_reader
# Synthetic local demo only; bootstrap creates distinct writer/read-only users.
CLICKHOUSE_PORT=8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=hospital_writer
CLICKHOUSE_PASSWORD=hospital_local_writer
CLICKHOUSE_ADMIN_PASSWORD=hospital_local_admin
REALTIME_ICU_BEDS=20
STREAM_METRICS_PORT=8090
PROMETHEUS_PORT=9090
REALTIME_SPARK_MASTER=local[2]
