# Copy to .env. Use the same credentials as TV2's local MinIO deployment.
# Never commit .env or actual credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
ICEBERG_CATALOG_URI=http://iceberg-rest:8181

# Host-side smoke client and published Docker port.
TRINO_HOST=localhost
TRINO_PORT=8080
