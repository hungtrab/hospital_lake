# Synthetic-data local development only. Replace before exposing the service.
MINIO_ACCESS_KEY=hospital_lake_local
MINIO_SECRET_KEY=hospital_lake_local_password
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

MINIO_REGION=us-east-1
ICEBERG_CATALOG_URI=http://iceberg-rest:8181

# Shared Spark settings (TV3). Endpoints above use Compose service names;
# host-side jobs must override them with reachable host addresses.
SPARK_MASTER=local[2]
ICEBERG_WAREHOUSE=s3://warehouse/

# Host-side smoke client and published Docker port.
TRINO_HOST=localhost
TRINO_PORT=8080
