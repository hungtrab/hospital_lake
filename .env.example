# Synthetic-data local development only. Replace before exposing the service.
MINIO_ACCESS_KEY=hospital_lake_local
MINIO_SECRET_KEY=hospital_lake_local_password
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Local image built from pinned source; upstream MinIO pulls are unavailable.
MINIO_IMAGE=hospital-lake/minio:RELEASE.2025-04-22T22-12-26Z

MINIO_REGION=us-east-1
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_REST_PORT=8181

# Shared Spark settings (TV3). Endpoints above use Compose service names;
# host-side jobs must override them with reachable host addresses.
SPARK_MASTER=local[2]
ICEBERG_WAREHOUSE=s3://warehouse/

# Week 4 local Kafka: host clients use localhost, Compose clients kafka:29092.
KAFKA_PORT=9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICS=hospital.events
# KAFKA_STARTING_OFFSETS=latest
# STREAM_CHECKPOINT_LOCATION=./checkpoints/stream-bronze

# Optional direct Compose bronze-ingest source mount. The Make target derives
# this from INPUT_DIR; inputs are mounted read-only and must already exist.
# BRONZE_INPUT_DIR=./data/generated

# TV4 Week 3 Gold: deterministic cutoff (generator end_date) and bed capacity for
# all five canonical departments. `make gold-docker` reads them from .env;
# host-side `make gold` needs them exported.
GOLD_AS_OF=2026-09-01T00:00:00Z
GOLD_BED_CAPACITIES=ICU=20,EMERGENCY=40,CARDIOLOGY=50,INTERNAL_MEDICINE=60,SURGERY=50

# Host-side smoke client and published Docker port.
TRINO_HOST=localhost
TRINO_PORT=8080
